generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Valores monetários sempre em centavos inteiros. `fundId` é reservado para os Fundos (V2).

// Cada pessoa tem o seu usuário: contas, metas, transações e configurações pertencem a um userId
// e somem junto com ele (onDelete: Cascade). As tabelas Session, Account, Verification, Passkey e
// RateLimit são do Better Auth (nomes e campos conforme a documentação da versão instalada).
model User {
  id                 String        @id @default(cuid())
  name               String        @default("")
  // Usuário legado (dados de antes do login) usa legado@financa.local até o claim-legacy.
  // As contas reais sempre informam o e-mail (Better Auth). O padrão gerado só existe para código que
  // cria usuários direto no banco (seeds, testes) sem se importar com e-mail.
  email              String        @unique @default(cuid())
  emailVerified      Boolean       @default(false)
  image              String?
  weeklyLivingCents  Int           @default(0)
  weekStartDay       Int           @default(1) // 0 = domingo … 6 = sábado
  onboarded          Boolean       @default(false)
  bills              Bill[]
  goals              Goal[]
  transactions       Transaction[]
  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  claims             OnboardingClaim[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

// Limite de tentativas do Better Auth (por IP e caminho), guardado no banco.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Envios de código por e-mail: limite por e-mail (o Better Auth só limita por IP).
model OtpSend {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Rascunho do onboarding já gravado na conta: o mesmo draftId nunca grava duas vezes.
model OnboardingClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftId   String
  createdAt DateTime @default(now())

  @@unique([userId, draftId])
}

model Bill {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundId       String?
  name         String
  amountCents  Int
  dueDay       Int
  savedCents   Int           @default(0)
  // Último vencimento (yyyy-mm-dd) já dado como pago/consumido; null = nenhum.
  paidThrough  String?
  // Saldo consumido ao considerar o vencimento pago (permite "Não foi pago").
  consumedCents Int         @default(0)
  // Vencimento marcado como "Não foi pago".
  unpaidDue    String?
  // Quanto ainda falta pagar do vencimento em atraso (0 = valor cheio da conta).
  unpaidCents  Int           @default(0)
  // Último vencimento que o usuário confirmou (pago ou em atraso).
  confirmedThrough String?
  createdAt    DateTime      @default(now())
  // "Substituir pelo novo plano": conta antiga arquivada some das telas e do motor; o histórico fica.
  archivedAt   DateTime?
  transactions Transaction[]

  @@index([userId])
}

model Goal {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundId       String?
  name         String
  targetCents  Int
  savedCents   Int           @default(0)
  deadline     String? // yyyy-mm
  weeklyCents  Int           @default(0)
  priority     Int
  isEmergency  Boolean       @default(false)
  // Base do marcador de "ritmo esperado" no Resumo.
  createdAt    DateTime      @default(now())
  // "Substituir pelo novo plano": meta antiga arquivada some das telas e do motor; o histórico fica.
  archivedAt   DateTime?
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // income | expense | allocation | withdrawal | bill_payment
  // | opening_balance (saldo que já existia fora do app) | adjustment (correção manual de saldo)
  type        String
  // Em `adjustment` é com sinal: negativo reduz o saldo da conta/meta.
  amountCents Int
  category    String?
  date        DateTime
  note        String?
  // Só em `adjustment`: match_bank | from_free | reset | used | return_to_free.
  // Em `opening_balance`: `paid_before` marca "vencimento já pago antes do Finança".
  reason      String?
  // Só em `adjustment`: a diferença entra ou sai do livre da semana.
  affectsWeeklyFree Boolean @default(false)
  // Só em `adjustment`: desfeito (o registro fica no histórico).
  undoneAt    DateTime?
  // Em `opening_balance` e `adjustment`: saldo da conta/meta logo depois do registro.
  balanceAfterCents Int?
  // Só em `income`: quanto faltou para o dia a dia naquele recebimento (null = antes deste campo).
  shortfallCents Int?
  // Liga o recebimento às alocações/retiradas geradas por ele (extrato).
  groupId     String?
  billId      String?
  bill        Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([userId, goalId])
  @@index([userId, billId])
  @@index([userId, type])
}

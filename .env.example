# Copie para `.env` e preencha. O caminho do SQLite é relativo à pasta `prisma/`.
# Local: SQLite. Na Vercel: a string do seu Postgres (postgresql://usuario:senha@host/db?sslmode=require).
DATABASE_URL="file:./dev.db"
# Só para Postgres com pooler (ex.: Neon): conexão DIRETA, usada para criar as tabelas no deploy.
# DIRECT_URL=""

# --- Login (Better Auth) ---------------------------------------------------
# Chave que assina as sessões. Gere com: npx @better-auth/cli secret  (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Endereço público do app. Local: http://localhost:3000. Produção: https://seu-dominio.com
# (em https os cookies saem com Secure; as passkeys usam o domínio daqui).
BETTER_AUTH_URL="http://localhost:3000"
# Opcional: outras origens aceitas, separadas por vírgula (ex.: o IP da rede local para abrir no celular).
# AUTH_TRUSTED_ORIGINS="http://192.168.0.10:3000"

# Continuar com Google: https://console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web"; URI de redirecionamento: <BETTER_AUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Continuar com Apple: pronto na configuração, mas DESLIGADO. Exige conta Apple Developer (paga).
# Para ligar: AUTH_APPLE_ENABLED=true e preencher os dois valores (Services ID e o segredo JWT).
AUTH_APPLE_ENABLED="false"
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# E-mail do código de login. Em desenvolvimento o código só aparece no terminal.
# Em produção usa o Resend: https://resend.com → API Keys, e um remetente de um domínio verificado.
RESEND_API_KEY=""
EMAIL_FROM="Finança <login@seu-dominio.com>"

# --- Só para testes automatizados (não use em produção) ----------------------
# EMAIL_TRANSPORT="file"   # grava o código num arquivo (EMAIL_FILE) em vez de enviar
# EMAIL_FILE=".otp/outbox.jsonl"
# AUTH_RATE_LIMIT="off"    # desliga o limite por IP (o e2e entra muitas vezes da mesma máquina)
# AUTH_OTP_MIN_GAP_SECONDS="0"   # intervalo mínimo entre códigos para o mesmo e-mail (padrão 30)

# Opcionais (só usados pelos testes e2e e builds paralelos; veja playwright.config.ts)
# NEXT_DIST_DIR=".next-e2e"
# NEXT_TSCONFIG="tsconfig.e2e.json"
